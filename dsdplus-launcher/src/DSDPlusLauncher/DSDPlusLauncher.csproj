<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>DSDPlusLauncher</RootNamespace>
    <AssemblyName>DSDPlusLauncher</AssemblyName>
    <Product>DSDPlus Launcher</Product>
    <Description>Interface graphique simple pour configurer et lancer DSDPlus (www.dsdplus.com)</Description>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
